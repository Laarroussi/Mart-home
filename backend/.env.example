# ============================================================
# CONFIGURATION ENVIRONNEMENT — Marfan APA Backend
# Copier ce fichier en `.env` et compléter les valeurs.
# Sur O2switch : variables à saisir dans cPanel → Setup Node.js App.
# ============================================================

# --- Application
NODE_ENV=production
PORT=3000
APP_URL=https://votre-domaine.fr
FRONTEND_URL=https://votre-domaine.fr

# --- PostgreSQL (sur O2switch : Bases de données → PostgreSQL → Créer)
# Format : postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://marfan_user:STRONG_PASSWORD@localhost:5432/marfan_apa
# Variables individuelles utilisables en alternative
DB_HOST=localhost
DB_PORT=5432
DB_USER=marfan_user
DB_PASSWORD=STRONG_PASSWORD
DB_NAME=marfan_apa
DB_SSL=false

# --- JWT (clé secrète pour signer les tokens — au moins 64 caractères)
JWT_SECRET=CHANGEZ_MOI_64_CHARS_ALEATOIRES_OBLIGATOIRE_POUR_LA_SECURITE_TOKEN
JWT_EXPIRES_IN=12h

# --- Bcrypt (rounds de hash : 10 = production, 4 = développement rapide)
BCRYPT_ROUNDS=10

# --- Upload de fichiers (CSV/XLSX VO2, pOpmètre)
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=20

# --- CORS (domaines autorisés, séparés par virgule)
CORS_ORIGINS=https://votre-domaine.fr,https://www.votre-domaine.fr

# --- Rate limiting (anti-abus)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# --- Comptes admin initiaux (créés au seed si absents)
ADMIN_EMAIL=admin@marfan-apa.fr
ADMIN_PASSWORD=ChangezMoiTresTresFortement123!

# --- Logs
LOG_LEVEL=info

# ============================================================
# --- Envoi d'e-mails : activation de compte patient (Phase 14)
# ============================================================
# Le patient reçoit un lien personnel, à usage unique, pour choisir
# lui-même son mot de passe. Aucun mot de passe n'est envoyé par e-mail.

# Adresse expéditrice (doit appartenir au domaine, sinon les mails partent en spam)
MAIL_FROM=Marfan APA <no-reply@marfan-sport-sante.fr>
# Adresse de réponse affichée au patient (optionnel)
MAIL_REPLY_TO=

# Base publique du site : sert à construire le lien d'activation
PUBLIC_BASE_URL=https://marfan-sport-sante.fr

# Durée de validité du lien, en heures (défaut 72)
ACTIVATION_TTL_HOURS=72

# --- Mode SMTP (recommandé). Créez l'adresse dans cPanel > Comptes de messagerie.
# Si ces variables sont absentes, le serveur bascule automatiquement sur le
# binaire sendmail local, présent par défaut sur o2switch (aucune config requise).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true

# Chemin du binaire sendmail (repli automatique)
SENDMAIL_PATH=/usr/sbin/sendmail
