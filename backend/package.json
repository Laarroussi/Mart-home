{
  "name": "marfan-apa-backend",
  "version": "1.0.0",
  "description": "Backend Node.js/Express + PostgreSQL pour la plateforme Marfan APA (déployé sur O2switch).",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node db/init.js",
    "db:seed": "node db/seed.js",
    "db:reset": "node db/reset-script.js && node db/init.js && node db/seed.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.11.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.2.0",
    "dotenv": "^16.4.5",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5",
    "joi": "^17.12.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "license": "MIT"
}
